{
  "name": "aero2687-study-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AERO2687 Introduction to Aerospace Engineering — interactive liquid-glass 3D formula & variable web (RMIT)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
